# Copy this file to .env and adjust values before running docker compose.
# .env is git-ignored so secrets never get committed, and this file is the
# single source of truth for config -- nothing is hardcoded in the app code,
# so the project runs the same on any machine you move it to.

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata
CORS_ALLOW_ALL_ORIGINS=True

# --- Postgres ---
POSTGRES_DB=civic_issue_db
POSTGRES_USER=civic_admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- ML ---
ML_MODEL_PATH=/app/ml_models/civic_issue_model.h5
